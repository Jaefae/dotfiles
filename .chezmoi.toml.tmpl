{{/* Prompted once on `chezmoi init`, cached in ~/.config/chezmoi/chezmoi.toml */}}
{{- $name := promptStringOnce . "name" "Full name for git config" "" -}}
{{- $email := promptStringOnce . "email" "Email for git config" "" -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
