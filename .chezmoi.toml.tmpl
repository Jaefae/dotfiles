{{/* Prompted once on `chezmoi init`, cached in ~/.config/chezmoi/chezmoi.toml */}}
{{- $name := promptStringOnce . "name" "Full name for git config" "" -}}
{{- $email := promptStringOnce . "email" "Email for git config" "" -}}

{{/* Self-referencing: whatever sourceDir chezmoi used to read this template
     is the one that must survive every future config regeneration (e.g. a
     `chezmoi init` re-run triggered by "config file template has changed"),
     otherwise it silently resets to the default ~/.local/share/chezmoi. */}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

{{ if eq .chezmoi.os "windows" -}}
{{/* Windows has no native shebang support, so .sh scripts (run_onchange_
     nvim-sync-plugins.sh) need an explicit interpreter. Resolved via Git for
     Windows' bash.exe on PATH. */}}
[interpreters.sh]
    command = "bash"
{{ end -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
