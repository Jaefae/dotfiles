# Generated from ../../.chezmoidata.yaml by chezmoi — do not hand-edit the palette block.
# Edit the theme there and run `chezmoi apply` to regenerate this file.

# Root-level settings must come before any [table] header: once a table
# header appears, bare key = value lines belong to that table until the
# next header, so these would otherwise get swallowed by [palettes.theme].
palette = "theme"
add_newline = false
format = """$directory$git_branch$git_status$character"""

[palettes.theme]
fg      = "#{{ .theme.palette.base05 }}"
bg      = "#{{ .theme.palette.base00 }}"
muted   = "#{{ .theme.palette.base03 }}"
red     = "#{{ .theme.palette.base08 }}"
orange  = "#{{ .theme.palette.base09 }}"
yellow  = "#{{ .theme.palette.base0A }}"
green   = "#{{ .theme.palette.base0B }}"
cyan    = "#{{ .theme.palette.base0C }}"
blue    = "#{{ .theme.palette.base0D }}"
magenta = "#{{ .theme.palette.base0E }}"

[directory]
style = "bold green"
truncation_length = 3
truncate_to_repo = true

[git_branch]
style = "bold magenta"
symbol = " "

[git_status]
style = "bold red"

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
