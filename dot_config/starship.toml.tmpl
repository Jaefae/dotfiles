# Generated by chezmoi from the theme in .chezmoidata/ — do not hand-edit the
# palette block. Switch themes with <leader>ft / `theme-pick` /
# `theme-sync <slug>`; edit a theme in .chezmoidata/theme-<slug>.yaml.
{{- template "theme-guard" . }}
{{- $palette := (index .themes .current_theme).palette }}

# Root-level settings must come before any [table] header: once a table
# header appears, bare key = value lines belong to that table until the
# next header, so these would otherwise get swallowed by [palettes.theme].
palette = "theme"
add_newline = false
format = """$directory$git_branch$git_status$character"""

[palettes.theme]
fg      = "#{{ $palette.base05 }}"
bg      = "#{{ $palette.base00 }}"
muted   = "#{{ $palette.base03 }}"
red     = "#{{ $palette.base08 }}"
orange  = "#{{ $palette.base09 }}"
yellow  = "#{{ $palette.base0A }}"
green   = "#{{ $palette.base0B }}"
cyan    = "#{{ $palette.base0C }}"
blue    = "#{{ $palette.base0D }}"
magenta = "#{{ $palette.base0E }}"

[directory]
style = "bold green"
truncation_length = 3
truncate_to_repo = true

[git_branch]
style = "bold magenta"
symbol = " "

[git_status]
style = "bold red"

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
