-- Generated by chezmoi from .chezmoidata/ — do not hand-edit.
{{- template "theme-guard" . }}
-- Lua-native view of the theme data, read by lua/theme.lua (startup and
-- the <leader>ft picker) so nvim never has to shell out to parse YAML.
return {
	current = "{{ .current_theme }}",
	themes = {
{{- range $slug, $theme := .themes }}
		["{{ $slug }}"] = {
			name = "{{ $theme.name }}",
			variant = "{{ $theme.variant }}",
			palette = {
{{- range $key, $value := $theme.palette }}
				{{ $key }} = "#{{ $value }}",
{{- end }}
			},
		},
{{- end }}
	},
}
