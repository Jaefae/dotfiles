-- Generated by chezmoi from the theme in .chezmoidata/ — do not hand-edit
-- the palette values below. Switch themes with <leader>ft / `theme-pick` /
-- `theme-sync <slug>`; edit a theme in .chezmoidata/theme-<slug>.yaml.
{{- template "theme-guard" . }}
{{- $theme := index .themes .current_theme }}
{{- $palette := $theme.palette }}
local M = {}

local scheme_name = "{{ $theme.name }}"

local scheme = {
	foreground = "#{{ $palette.base05 }}",
	background = "#{{ $palette.base00 }}",
	cursor_bg = "#{{ $palette.base05 }}",
	cursor_fg = "#{{ $palette.base00 }}",
	cursor_border = "#{{ $palette.base05 }}",
	selection_bg = "#{{ $palette.base02 }}",
	selection_fg = "#{{ $palette.base05 }}",
	ansi = {
		"#{{ $palette.base00 }}",
		"#{{ $palette.base08 }}",
		"#{{ $palette.base0B }}",
		"#{{ $palette.base0A }}",
		"#{{ $palette.base0D }}",
		"#{{ $palette.base0E }}",
		"#{{ $palette.base0C }}",
		"#{{ $palette.base05 }}",
	},
	brights = {
		"#{{ $palette.base10 }}",
		"#{{ $palette.base12 }}",
		"#{{ $palette.base14 }}",
		"#{{ $palette.base13 }}",
		"#{{ $palette.base16 }}",
		"#{{ $palette.base17 }}",
		"#{{ $palette.base15 }}",
		"#{{ $palette.base07 }}",
	},
}

function M.apply_to_config(config)
	config.color_schemes = { [scheme_name] = scheme }
	config.color_scheme = scheme_name

	-- Classic (non-fancy) tab bar colors, since the fancy tab bar ignores
	-- these and draws from the OS window chrome instead.
	config.colors = {
		split = "#{{ $palette.base02 }}",
		scrollbar_thumb = "#{{ $palette.base02 }}",
		compose_cursor = "#{{ $palette.base09 }}",
		visual_bell = "#{{ $palette.base02 }}",
		-- base16-shell convention: 16 = orange, 17 = brown/misc, for tools that
		-- address the extra palette slots directly.
		indexed = {
			[16] = "#{{ $palette.base09 }}",
			[17] = "#{{ $palette.base0F }}",
		},
		-- QuickSelect (LEADER+g, CTRL+SHIFT+Space) and copy mode default to
		-- fixed colors that can clash with the theme.
		quick_select_label_bg = { Color = "#{{ $palette.base0A }}" },
		quick_select_label_fg = { Color = "#{{ $palette.base00 }}" },
		quick_select_match_bg = { Color = "#{{ $palette.base02 }}" },
		quick_select_match_fg = { Color = "#{{ $palette.base05 }}" },
		copy_mode_active_highlight_bg = { Color = "#{{ $palette.base0A }}" },
		copy_mode_active_highlight_fg = { Color = "#{{ $palette.base00 }}" },
		copy_mode_inactive_highlight_bg = { Color = "#{{ $palette.base02 }}" },
		copy_mode_inactive_highlight_fg = { Color = "#{{ $palette.base05 }}" },
		tab_bar = {
			background = "#{{ $palette.base01 }}",
			active_tab = {
				bg_color = "#{{ $palette.base02 }}",
				fg_color = "#{{ $palette.base05 }}",
			},
			inactive_tab = {
				bg_color = "#{{ $palette.base01 }}",
				fg_color = "#{{ $palette.base04 }}",
			},
			inactive_tab_hover = {
				bg_color = "#{{ $palette.base02 }}",
				fg_color = "#{{ $palette.base06 }}",
			},
			new_tab = {
				bg_color = "#{{ $palette.base01 }}",
				fg_color = "#{{ $palette.base04 }}",
			},
			new_tab_hover = {
				bg_color = "#{{ $palette.base02 }}",
				fg_color = "#{{ $palette.base06 }}",
			},
		},
	}
end

return M
