	background = "#{{ .theme.palette.base00 }}",
	cursor_bg = "#{{ .theme.palette.base05 }}",
	cursor_fg = "#{{ .theme.palette.base00 }}",
	cursor_border = "#{{ .theme.palette.base05 }}",
	selection_bg = "#{{ .theme.palette.base02 }}",
