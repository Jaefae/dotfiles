		"#{{ .theme.palette.base15 }}",
		"#{{ .theme.palette.base07 }}",
	},
}

function M.apply_to_config(config)
	config.color_schemes = { [scheme_name] = scheme }
	config.color_scheme = scheme_name

	-- Classic (non-fancy) tab bar colors, since the fancy tab bar ignores
	-- these and draws from the OS window chrome instead.
	config.colors = {
		tab_bar = {
			background = "#{{ .theme.palette.base01 }}",
			active_tab = {
				bg_color = "#{{ .theme.palette.base02 }}",
				fg_color = "#{{ .theme.palette.base05 }}",
