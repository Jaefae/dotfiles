-- Generated by chezmoi from the theme in .chezmoidata/ — do not hand-edit
-- the palette values below. Switch themes with <leader>ft / `theme-pick` /
-- `theme-sync <slug>`; edit a theme in .chezmoidata/theme-<slug>.yaml.
{{- template "theme-guard" . }}
{{- $theme := index .themes .current_theme }}
{{- $palette := $theme.palette }}
local M = {}

local scheme_name = "{{ $theme.name }}"

local scheme = {
	foreground = "#{{ $palette.base05 }}",
	background = "#{{ $palette.base00 }}",
	cursor_bg = "#{{ $palette.base05 }}",
	cursor_fg = "#{{ $palette.base00 }}",
	cursor_border = "#{{ $palette.base05 }}",
	selection_bg = "#{{ $palette.base02 }}",
	selection_fg = "#{{ $palette.base05 }}",
	ansi = {
		"#{{ $palette.base00 }}",
		"#{{ $palette.base08 }}",
		"#{{ $palette.base0B }}",
		"#{{ $palette.base0A }}",
		"#{{ $palette.base0D }}",
		"#{{ $palette.base0E }}",
		"#{{ $palette.base0C }}",
		"#{{ $palette.base05 }}",
	},
	brights = {
		"#{{ $palette.base10 }}",
		"#{{ $palette.base12 }}",
		"#{{ $palette.base14 }}",
		"#{{ $palette.base13 }}",
		"#{{ $palette.base16 }}",
		"#{{ $palette.base17 }}",
		"#{{ $palette.base15 }}",
		"#{{ $palette.base07 }}",
	},
}

function M.apply_to_config(config)
	config.color_schemes = { [scheme_name] = scheme }
	config.color_scheme = scheme_name

	-- Classic (non-fancy) tab bar colors, since the fancy tab bar ignores
	-- these and draws from the OS window chrome instead.
	config.colors = {
		tab_bar = {
			background = "#{{ $palette.base01 }}",
			active_tab = {
				bg_color = "#{{ $palette.base02 }}",
				fg_color = "#{{ $palette.base05 }}",
			},
			inactive_tab = {
				bg_color = "#{{ $palette.base01 }}",
				fg_color = "#{{ $palette.base04 }}",
			},
			inactive_tab_hover = {
				bg_color = "#{{ $palette.base02 }}",
				fg_color = "#{{ $palette.base06 }}",
			},
			new_tab = {
				bg_color = "#{{ $palette.base01 }}",
				fg_color = "#{{ $palette.base04 }}",
			},
			new_tab_hover = {
				bg_color = "#{{ $palette.base02 }}",
				fg_color = "#{{ $palette.base06 }}",
			},
		},
	}
end

return M
