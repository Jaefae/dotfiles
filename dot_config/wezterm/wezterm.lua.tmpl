local wezterm = require("wezterm")
local config = wezterm.config_builder()

-- Modules live alongside this file and are loaded from the rendered config
-- directory, so `require` needs config_dir on its search path.
package.path = package.path .. ";" .. wezterm.config_dir .. "/?.lua"

require("theme").apply_to_config(config)
require("platform").apply_to_config(config)
require("keys").apply_to_config(config)
require("hyperlinks").apply_to_config(config)
require("statusbar").apply_to_config(config)

-- WezTerm only auto-reloads on changes to this file; required modules
-- (theme.lua in particular, rewritten live by the theme picker) need to be
-- added to the watch list explicitly to get the same live-reload behavior.
for _, name in ipairs({ "theme.lua", "platform.lua", "keys.lua", "hyperlinks.lua", "statusbar.lua" }) do
	wezterm.add_to_config_reload_watch_list(wezterm.config_dir .. "/" .. name)
end

config.max_fps = 120
config.animation_fps = 60
config.default_cursor_style = "SteadyBlock"
config.font = wezterm.font_with_fallback({
	"Monaspace Neon",
	"Symbols Nerd Font Mono",
})
config.font_size = 12.0

config.scrollback_lines = 10000
config.hide_tab_bar_if_only_one_tab = true
config.use_fancy_tab_bar = false
config.window_decorations = "RESIZE"

return config
