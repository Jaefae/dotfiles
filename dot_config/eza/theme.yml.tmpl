{{- template "theme-guard" . }}
{{- $p := (index .themes .current_theme).palette -}}
# Generated by chezmoi from the theme in .chezmoidata/ — do not hand-edit.
# eza reads this from $EZA_CONFIG_DIR (exported by the shell profiles; on
# macOS eza would otherwise look in ~/Library/Application Support) on
# every run, so theme switches apply to the next `ls`.
filekinds:
  normal: {foreground: "#{{ $p.base05 }}"}
  directory: {foreground: "#{{ $p.base0D }}", is_bold: true}
  symlink: {foreground: "#{{ $p.base0C }}"}
  pipe: {foreground: "#{{ $p.base0A }}"}
  block_device: {foreground: "#{{ $p.base0A }}", is_bold: true}
  char_device: {foreground: "#{{ $p.base0A }}", is_bold: true}
  socket: {foreground: "#{{ $p.base0E }}", is_bold: true}
  special: {foreground: "#{{ $p.base0A }}"}
  executable: {foreground: "#{{ $p.base0B }}", is_bold: true}
  mount_point: {foreground: "#{{ $p.base0D }}", is_bold: true, is_underline: true}
perms:
  user_read: {foreground: "#{{ $p.base0A }}", is_bold: true}
  user_write: {foreground: "#{{ $p.base08 }}", is_bold: true}
  user_execute_file: {foreground: "#{{ $p.base0B }}", is_bold: true}
  user_execute_other: {foreground: "#{{ $p.base0B }}", is_bold: true}
  group_read: {foreground: "#{{ $p.base0A }}"}
  group_write: {foreground: "#{{ $p.base08 }}"}
  group_execute: {foreground: "#{{ $p.base0B }}"}
  other_read: {foreground: "#{{ $p.base0A }}"}
  other_write: {foreground: "#{{ $p.base08 }}"}
  other_execute: {foreground: "#{{ $p.base0B }}"}
  special_user_file: {foreground: "#{{ $p.base0E }}"}
  special_other: {foreground: "#{{ $p.base0E }}"}
  attribute: {foreground: "#{{ $p.base03 }}"}
size:
  major: {foreground: "#{{ $p.base0C }}", is_bold: true}
  minor: {foreground: "#{{ $p.base0C }}"}
  number_byte: {foreground: "#{{ $p.base0C }}"}
  number_kilo: {foreground: "#{{ $p.base0C }}"}
  number_mega: {foreground: "#{{ $p.base0C }}", is_bold: true}
  number_giga: {foreground: "#{{ $p.base09 }}", is_bold: true}
  number_huge: {foreground: "#{{ $p.base08 }}", is_bold: true}
  unit_byte: {foreground: "#{{ $p.base03 }}"}
  unit_kilo: {foreground: "#{{ $p.base03 }}"}
  unit_mega: {foreground: "#{{ $p.base03 }}"}
  unit_giga: {foreground: "#{{ $p.base03 }}"}
  unit_huge: {foreground: "#{{ $p.base03 }}"}
users:
  user_you: {foreground: "#{{ $p.base0A }}", is_bold: true}
  user_root: {foreground: "#{{ $p.base08 }}", is_bold: true}
  user_other: {foreground: "#{{ $p.base04 }}"}
  group_yours: {foreground: "#{{ $p.base0A }}"}
  group_root: {foreground: "#{{ $p.base08 }}"}
  group_other: {foreground: "#{{ $p.base04 }}"}
links:
  normal: {foreground: "#{{ $p.base0C }}", is_bold: true}
  multi_link_file: {foreground: "#{{ $p.base0C }}", background: "#{{ $p.base02 }}"}
git:
  new: {foreground: "#{{ $p.base0B }}"}
  modified: {foreground: "#{{ $p.base0A }}"}
  deleted: {foreground: "#{{ $p.base08 }}"}
  renamed: {foreground: "#{{ $p.base0C }}"}
  typechange: {foreground: "#{{ $p.base0E }}"}
  ignored: {foreground: "#{{ $p.base03 }}"}
  conflicted: {foreground: "#{{ $p.base08 }}", is_bold: true}
git_repo:
  branch_main: {foreground: "#{{ $p.base0B }}"}
  branch_other: {foreground: "#{{ $p.base0E }}"}
  git_clean: {foreground: "#{{ $p.base0B }}"}
  git_dirty: {foreground: "#{{ $p.base0A }}"}
file_type:
  image: {foreground: "#{{ $p.base0E }}"}
  video: {foreground: "#{{ $p.base0E }}", is_bold: true}
  music: {foreground: "#{{ $p.base0C }}"}
  lossless: {foreground: "#{{ $p.base0C }}", is_bold: true}
  crypto: {foreground: "#{{ $p.base09 }}", is_bold: true}
  document: {foreground: "#{{ $p.base05 }}"}
  compressed: {foreground: "#{{ $p.base08 }}"}
  temp: {foreground: "#{{ $p.base03 }}"}
  compiled: {foreground: "#{{ $p.base03 }}"}
  build: {foreground: "#{{ $p.base0A }}", is_underline: true}
  source: {foreground: "#{{ $p.base05 }}"}
punctuation: {foreground: "#{{ $p.base03 }}"}
date: {foreground: "#{{ $p.base0D }}"}
inode: {foreground: "#{{ $p.base0E }}"}
blocks: {foreground: "#{{ $p.base0C }}"}
header: {foreground: "#{{ $p.base05 }}", is_underline: true}
octal: {foreground: "#{{ $p.base0E }}"}
flags: {foreground: "#{{ $p.base0E }}"}
symlink_path: {foreground: "#{{ $p.base0C }}"}
control_char: {foreground: "#{{ $p.base08 }}"}
broken_symlink: {foreground: "#{{ $p.base08 }}"}
broken_path_overlay: {is_underline: true}
