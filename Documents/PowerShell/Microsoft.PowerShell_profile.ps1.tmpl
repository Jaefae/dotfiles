# Managed by chezmoi — source repo: Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tmpl

$gitUsrBin = Join-Path (Split-Path (Get-Command git).Source -Parent) "..\usr\bin" -Resolve -ErrorAction SilentlyContinue
if ($gitUsrBin) {
    $env:PATH = "$gitUsrBin;$env:PATH"
}
$env:PATH = "$HOME\.local\bin;$HOME\.cargo\bin;$env:PATH"

# Theme files written by chezmoi from .chezmoidata/ (switch with
# theme-pick.ps1 or <leader>ft). Both tools re-read them on every run, so a
# theme switch applies to the next invocation. eza needs the explicit dir:
# on Windows it would otherwise look in %APPDATA%\eza.
$env:FZF_DEFAULT_OPTS_FILE = "$HOME\.config\fzf\theme"
$env:EZA_CONFIG_DIR = "$HOME\.config\eza"

if (Get-Command eza -ErrorAction SilentlyContinue) {
    Remove-Item Alias:ls -ErrorAction SilentlyContinue
    Remove-Item Alias:ll -ErrorAction SilentlyContinue
    function ls { eza @args }
    function ll { eza -l @args }
}

if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (&starship init powershell)
}

if (Get-Command zoxide -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (zoxide init powershell | Out-String) })
}
