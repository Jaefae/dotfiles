{{ if eq .chezmoi.os "windows" -}}
# Installs the tools this config depends on, via winget.
$packages = @(
    "wez.wezterm",
    "Neovim.Neovim",
    "Starship.Starship",
    "ajeetdsouza.zoxide",
    "eza-community.eza",
    "sharkdp.fd",
    "BurntSushi.ripgrep.MSVC",
    "Git.Git"
)

foreach ($pkg in $packages) {
    winget install --id $pkg --accept-source-agreements --accept-package-agreements -e --silent
}

# Unify config resolution across OSes: let WezTerm/Neovim/starship all read
# from %USERPROFILE%\.config on Windows too, same as macOS/Linux.
[Environment]::SetEnvironmentVariable("XDG_CONFIG_HOME", "$env:USERPROFILE\.config", "User")
{{ end -}}
