#!/bin/bash
# Lists the themes from .chezmoidata/ via fzf and hands the choice to
# theme-sync, which re-applies every themed file (WezTerm, starship, fzf,
# eza, Neovim) and recolors running Neovim instances too.
set -euo pipefail

list_template='{{ range $slug, $t := .themes }}{{ $slug }}  {{ $t.name }}
{{ end }}'

choice="$(
	chezmoi execute-template "$list_template" \
		| fzf --prompt="Theme> " --with-nth=2.. --delimiter='  ' \
		|| true
)"

if [ -z "$choice" ]; then
	exit 0
fi

slug="$(awk '{print $1}' <<<"$choice")"
"$(dirname "$0")/theme-sync" "$slug"
