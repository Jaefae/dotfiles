#!/bin/bash
# Switches this machine's theme: records the choice in the git-ignored
# .chezmoidata/zz-local.yaml (read last, so it overrides the default in
# .chezmoidata/00-defaults.yaml), re-applies every themed file through
# chezmoi, and recolors any running Neovim instances.
#
# Themed files are discovered, not listed: any template that includes
# {{ template "theme-guard" . }} is re-applied. Theming a new tool only
# takes writing such a template.
#
# Called by the <leader>ft Telescope picker inside Neovim and by the
# standalone `theme-pick` (fzf) script. Usage: theme-sync <theme-slug>
#
# Must stay compatible with macOS's /bin/bash 3.2 (no mapfile, no ${x,,}).
set -euo pipefail

if [ $# -ne 1 ]; then
	echo "usage: theme-sync <theme-slug>" >&2
	exit 1
fi
slug="$1"

source_dir="$(chezmoi source-path)"
local_file="$source_dir/.chezmoidata/zz-local.yaml"

# 1. Validate before touching anything.
known="$(chezmoi execute-template '{{ keys .themes | sortAlpha | join "\n" }}')"
if ! grep -qxF -- "$slug" <<<"$known"; then
	echo "theme-sync: unknown theme '$slug'. Known themes:" >&2
	sed 's/^/  /' <<<"$known" >&2
	exit 1
fi

# 2. Find the themed targets: source templates that include theme-guard,
#    mapped to their destinations, keeping only ones chezmoi manages on this
#    OS (.chezmoiignore may exclude some).
managed="$(chezmoi managed --path-style absolute)"
targets=()
while IFS= read -r template; do
	target="$(chezmoi target-path "$source_dir/$template")"
	if grep -qxF -- "$target" <<<"$managed"; then
		targets+=("$target")
	fi
done < <(
	cd "$source_dir" &&
		grep -rlF --include='*.tmpl' 'template "theme-guard"' \
			--exclude-dir=.git --exclude-dir=.chezmoitemplates --exclude-dir=scripts . |
		sed 's|^\./||' | sort
)
if [ "${#targets[@]}" -eq 0 ]; then
	echo "theme-sync: no themed templates found under $source_dir" >&2
	exit 1
fi

# 3. Record the selection, then apply. --force skips chezmoi's "changed since
#    last written" prompt for these targets only; chezmoi writes each file
#    atomically and records it in its state, so a later `chezmoi apply` stays
#    a no-op. On failure, put the previous selection back and re-apply it.
previous=""
if [ -f "$local_file" ]; then
	previous="$(cat "$local_file")"
fi
write_selection() {
	printf '%s\n' "$1" >"$local_file.tmp"
	mv "$local_file.tmp" "$local_file"
}
write_selection "current_theme: \"$slug\""

if ! chezmoi apply --force -- "${targets[@]}"; then
	echo "theme-sync: applying '$slug' failed; restoring the previous theme" >&2
	if [ -n "$previous" ]; then
		write_selection "$previous"
	else
		rm -f "$local_file"
	fi
	chezmoi apply --force -- "${targets[@]}" || true
	exit 1
fi

# 4. Recolor running Neovim instances. theme-broadcast.lua sends each one a
#    non-blocking RPC notification, so an nvim waiting at a prompt can't hang
#    this script; it switches as soon as it's free.
broadcaster="$HOME/.config/nvim/theme-broadcast.lua"
if command -v nvim >/dev/null 2>&1 && [ -f "$broadcaster" ]; then
	sockets=()
	for socket in "${TMPDIR:-/tmp}"/nvim."$USER"/*/nvim.*.0 "${XDG_RUNTIME_DIR:-/nonexistent}"/nvim.*.0; do
		[ -S "$socket" ] && sockets+=("$socket")
	done
	if [ "${#sockets[@]}" -gt 0 ]; then
		nvim --clean -l "$broadcaster" "$slug" "${sockets[@]}" >/dev/null 2>&1 || true
	fi
fi

echo "Theme set to $slug"
