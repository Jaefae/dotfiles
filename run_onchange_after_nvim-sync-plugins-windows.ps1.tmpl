# Re-runs whenever the plugin spec changes (hash below, of the raw,
# unrendered template source — stable across theme switches since those
# only change the resolved palette values, not the template text itself),
# via chezmoi's run_onchange_ convention.
# chezmoi-colorscheme-hash: {{ include "dot_config/nvim/lua/plugins/colorscheme.lua.tmpl" | sha256sum }}

if (Get-Command nvim -ErrorAction SilentlyContinue) {
    nvim --headless "+Lazy! sync" +qa
}
