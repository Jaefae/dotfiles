{{- /* Shared body of dot_bashrc.tmpl and dot_zshrc.tmpl, included as
       {{ template "shellrc" "zsh" }}: the argument is the shell name, used
       for the starship/zoxide init calls. POSIX sh syntax only, so it reads
       the same in bash and zsh. */ -}}
{{- $shell := . -}}
# Managed by chezmoi — shared body in .chezmoitemplates/shellrc.

# Prepends a directory to PATH once, so nested shells don't keep growing it.
path_prepend() {
	case ":$PATH:" in
		*":$1:"*) ;;
		*) PATH="$1:$PATH" ;;
	esac
}

# Homebrew: a fresh machine may not have `brew shellenv` in ~/.zprofile
# yet (and bash never reads that file), so pick it up here if brew exists
# but isn't on PATH.
if ! command -v brew >/dev/null 2>&1; then
	for brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
		if [ -x "$brew" ]; then
			eval "$("$brew" shellenv)"
			break
		fi
	done
fi

path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.local/bin"
export PATH

# Theme files written by chezmoi from .chezmoidata/ (switch with theme-pick
# or <leader>ft). Both tools re-read them on every run, so a theme switch
# applies to the next invocation without restarting the shell. eza needs
# the explicit dir: on macOS it would otherwise look in
# ~/Library/Application Support.
export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/theme"
export EZA_CONFIG_DIR="$HOME/.config/eza"

if command -v eza >/dev/null 2>&1; then
	alias ls="eza"
	alias ll="eza -l"
fi

if command -v starship >/dev/null 2>&1; then
	eval "$(starship init {{ $shell }})"
fi

if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init {{ $shell }})"
fi
